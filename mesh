#!/usr/bin/env bash
set -e

# Capture the caller's current directory before we change into Mesh's own
# directory below, so main.py can be told where the user actually invoked
# `mesh` from (this lets `mesh` be called from anywhere, not just its own dir).
CALLER_DIR="$(pwd)"

# Resolve the script directory and change to it
MESH_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$MESH_DIR"

# Ensure Python uses UTF-8 encoding for stdin/stdout
export PYTHONIOENCODING=utf-8

# Auto-bootstrap if the virtual environment is missing or incomplete (e.g. a
# previous bootstrap run failed partway through and left a python symlink
# behind without pip - checking for pip here, not just python, makes sure
# that gets repaired automatically instead of silently reused).
if [ ! -f ".venv/bin/pip" ]; then
    echo "[!] Virtual environment not found or incomplete (.venv/bin/pip)."
    echo "[+] Running ./bootstrap to initialize environment..."
    ./bootstrap
fi

exec .venv/bin/python main.py --cwd "$CALLER_DIR" "$@"
